#!/bin/bash

set -e

# Default values
CONFIG_PATH=""
PROJECT_DIR="/workspace"
WORKSPACE_DIR="/workspace/workspace"

# Help function
function show_help {
  echo "Ngine CLI - Angular Enterprise Framework"
  echo ""
  echo "Usage:"
  echo "  ngine scaffold [--config <path>]   Create a new Angular project with Ngine framework"
  echo "  ngine add-feature <name>           Add a new feature module"
  echo "  ngine edit entity <name>           Edit an entity model"
  echo "  ngine upgrade angular              Upgrade Angular version"
  echo "  ngine shell                        Enter interactive shell"
  echo "  ngine version                      Show version information"
  echo "  ngine run <command>                Run a command in the workspace"
  echo "  ngine init-config                  Initialize config templates in .setup/config folder"
  echo "  ngine --help                       Show this help message"
  echo ""
  echo "Examples:"
  echo "  ngine scaffold                                # Create project with settings from .setup/config/project.yaml"
  echo "  ngine scaffold --config .setup/config/custom.yaml    # Create project with custom config"
}

# Initialize config templates
function init_config {
  echo "🔧 Initializing configuration templates..."
  
  # Create config directory if it doesn't exist
  mkdir -p "$PROJECT_DIR/.setup/config"
  
  # Check if template directory exists in container
  if [ -d "/ngine/.setup/templates" ]; then
    # Copy templates from container
    cp -r /ngine/.setup/templates/* "$PROJECT_DIR/.setup/config/"
  else
    echo "❌ Template directory not found in container"
    exit 1
  fi
  
  echo "✅ Configuration templates initialized in .setup/config/"
  echo "You can now edit these templates and run 'ngine scaffold'"
}

# Function to load config from YAML
function load_config {
  local config_file=$1
  local default_config="/workspace/.setup/config/project.yaml"
  
  # Use default config if none provided
  if [ -z "$config_file" ]; then
    if [ -f "$default_config" ]; then
      echo "Using configuration from $default_config"
      config_file=$default_config
    else
      echo "No configuration file found at $default_config"
      echo "Run 'ngine init-config' to initialize configuration templates"
      echo "Using default configuration"
    fi
  fi
  
  # Check if specified config file exists
  if [ -n "$config_file" ] && [ ! -f "$config_file" ]; then
    echo "Warning: Configuration file not found at $config_file"
    echo "Continuing with default configuration"
  fi
  
  # If we have a config file, extract app prefix
  if [ -n "$config_file" ] && [ -f "$config_file" ]; then
    APP_PREFIX=$(grep "appPrefix:" "$config_file" | head -n1 | cut -d ":" -f2 | tr -d ' ')
    
    # Use default if not found
    if [ -z "$APP_PREFIX" ]; then
      APP_PREFIX="ngine"
    fi
  else
    APP_PREFIX="ngine"
  fi
  
  echo "Configuration loaded:"
  echo "- App prefix: $APP_PREFIX"
}

# Scaffold a new project
function scaffold_project {
  echo "🚀 Scaffolding new Ngine project..."
  
  # Load configuration
  load_config "$CONFIG_PATH"
  
  # Ensure workspace directory exists
  mkdir -p "$WORKSPACE_DIR"
  
  echo "📦 Creating NX workspace in $WORKSPACE_DIR..."
  
  # Create NX workspace with Angular
  cd "$PROJECT_DIR"
  npx create-nx-workspace@latest "workspace" \
    --preset=angular \
    --appName="$APP_PREFIX" \
    --style=scss \
    --nx-cloud=false \
    --no-nxCloud \
    --skipGit
  
  cd "$WORKSPACE_DIR"
  
  # Install dependencies
  echo "📚 Installing dependencies..."
  pnpm add @angular/material @ngrx/store @ngrx/effects @ngrx/entity @ngrx/component-store @ngrx/component @ngrx/store-devtools
  
  # Setup Firebase
  echo "🔥 Setting up Firebase..."
  pnpm add firebase @angular/fire
  
  # Create Firebase directory structure
  mkdir -p firebase/functions firebase/data
  
  # Create Firebase config files
  echo "rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}" > firebase/firestore.rules

  echo "rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}" > firebase/storage.rules

  echo '{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true
    }
  }
}' > firebase.json

  echo "[]" > firebase/firestore.indexes.json
  
  # Setup Storybook
  echo "📚 Setting up Storybook..."
  npx nx g @nx/storybook:configuration "$APP_PREFIX" --configureCypress
  
  # Create libs folder structure
  echo "🏗️ Creating library structure..."
  npx nx g @nx/js:lib common-models --buildable --publishable --importPath=@ngacademy/common-models
  npx nx g @nx/js:lib common-utils --buildable --publishable --importPath=@ngacademy/common-utils
  npx nx g @nx/angular:lib lib-ngine --buildable --publishable --importPath=@ngacademy/lib-ngine
  
  # Copy configuration from project root if exists
  if [ -d "/workspace/.setup/config" ]; then
    echo "📄 Copying project configuration..."
    mkdir -p ./.setup
    cp -r /workspace/.setup/config ./.setup/
  fi
  
  # Create .nvmrc file
  echo "v22" > .nvmrc
  
  # Set up ESLint config
  echo "module.exports = {
  root: true,
  ignorePatterns: ['**/*'],
  plugins: ['@nx'],
  extends: [
    'eslint:recommended',
    'plugin:@typescript-eslint/recommended',
    'plugin:@angular-eslint/recommended'
  ],
  overrides: [
    {
      files: ['*.ts', '*.tsx', '*.js', '*.jsx'],
      rules: {
        '@nx/enforce-module-boundaries': [
          'error',
          {
            enforceBuildableLibDependency: true,
            allow: [],
            depConstraints: [
              {
                sourceTag: '*',
                onlyDependOnLibsWithTags: ['*']
              }
            ]
          }
        ]
      }
    },
    {
      files: ['*.ts', '*.tsx'],
      extends: ['plugin:@nx/typescript'],
      rules: {}
    },
    {
      files: ['*.js', '*.jsx'],
      extends: ['plugin:@nx/javascript'],
      rules: {}
    }
  ]
};" > .eslintrc.js

  # Create VSCode settings
  mkdir -p .vscode
  echo '{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  "eslint.validate": ["javascript", "typescript", "html"],
  "eslint.format.enable": true
}' > .vscode/settings.json

  # Create README
  echo "# Ngine Angular Enterprise Application

This project was generated with [Ngine](https://github.com/ngacademy/ngine), an Angular Enterprise Framework.

## Development server

Run \`nx serve $APP_PREFIX\` for a dev server. Navigate to http://localhost:4200/. The app will automatically reload if you change any of the source files.

## Storybook

Run \`nx run $APP_PREFIX:storybook\` to start Storybook.

## Build

Run \`nx build $APP_PREFIX\` to build the project. The build artifacts will be stored in the \`dist/\` directory.

## Running tests

Run \`nx test $APP_PREFIX\` to execute the unit tests via [Jest](https://jestjs.io).
Run \`nx e2e $APP_PREFIX-e2e\` to execute the end-to-end tests via [Cypress](https://www.cypress.io).

## Firebase

Start emulators with \`firebase emulators:start\`

## Further help

Visit the [Ngine documentation](https://github.com/ngacademy/ngine) for more information.
" > README.md

  echo "✅ Project successfully scaffolded in $WORKSPACE_DIR!"
  echo ""
  echo "To start the development server:"
  echo "  cd workspace"
  echo "  nx serve $APP_PREFIX"
}

# Version function
function show_version {
  echo "Ngine v0.1.0"
  echo "Node $(node -v)"
  echo "Angular CLI $(ng version --version)"
  echo "pnpm v$(pnpm -v)"
  echo "Nx $(nx --version)"
}

# Parse command line arguments
COMMAND=$1
shift

case $COMMAND in
  init-config)
    init_config
    ;;
    
  scaffold)
    while [[ "$#" -gt 0 ]]; do
      case $1 in
        --config) CONFIG_PATH="$2"; shift ;;
        *) echo "Unknown parameter: $1"; exit 1 ;;
      esac
      shift
    done
    scaffold_project
    ;;
    
  add-feature)
    echo "Feature module creation not implemented yet"
    ;;
    
  edit)
    if [ "$1" = "entity" ]; then
      echo "Entity editing not implemented yet"
    else
      echo "Unknown edit command: $1"
      show_help
    fi
    ;;
    
  upgrade)
    if [ "$1" = "angular" ]; then
      echo "Angular upgrade not implemented yet"
    else
      echo "Unknown upgrade command: $1"
      show_help
    fi
    ;;
    
  shell)
    echo "Starting interactive shell..."
    exec /bin/bash
    ;;
    
  version)
    show_version
    ;;
    
  run)
    cd "$WORKSPACE_DIR"
    exec "$@"
    ;;
    
  --help)
    show_help
    ;;
    
  *)
    echo "Unknown command: $COMMAND"
    show_help
    exit 1
    ;;
esac
